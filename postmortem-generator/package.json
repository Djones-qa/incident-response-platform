{
  "name": "postmortem-generator",
  "version": "1.0.0",
  "description": "Generates structured post-mortems from incident timelines stored in Redis",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "express": "4.18.2",
    "ioredis": "5.3.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.11",
    "@types/node": "20.11.5",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "typescript": "5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"]
  }
}
